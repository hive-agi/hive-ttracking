{:paths ["src"]
 :deps
 {org.clojure/clojure {:mvn/version "1.12.6"}
  metosin/malli       {:mvn/version "0.20.3"}}

 :aliases
 {:test {:extra-paths ["test" "test-resources"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                      org.clojure/test.check {:mvn/version "1.1.3"}}
         :main-opts ["-m" "kaocha.runner"]}

  :cljs {:extra-paths ["test"]
         :extra-deps {thheller/shadow-cljs {:mvn/version "2.28.20"}
                      org.clojure/test.check {:mvn/version "1.1.3"}}}

  ;; The release job runs `clojure -T:build` with CWD = time/, so hive-build
  ;; reads this directory's version.edn, not the repository root's.
  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.3.3"}}
          :ns-default hive-build.api}}}
