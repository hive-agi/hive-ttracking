{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        com.taoensso/timbre {:mvn/version "6.8.0"}

        ;; hive-dsl — Result monad, rescue/guard DSL, bounded-atom, ADTs
        io.github.hive-agi/hive-dsl {:mvn/version "0.5.14"}

        ;; hive-events — event bus for :tt/* events
        ;; TODO: flip to {:mvn/version "0.5.2"} once hive-events lands on Clojars.
        io.github.hive-agi/hive-events
        {:mvn/version "0.5.6"}

        ;; hive-weave — named pools, timed execution, parallel primitives
        ;; (Wave 3+ dependency, kept here to pin Wave-1 skeleton deps)
        io.github.hive-agi/hive-weave {:mvn/version "0.3.1"}

        ;; hive-addon — standalone IAddon contract leaf (hive-addon.protocol/IAddon).
        ;; Compile dep for the mounter-ready addon-ctor; the live hive-mcp tree
        ;; overrides to the local 0.3.1 sibling (mount.compose) at runtime.
        io.github.hive-agi/hive-addon {:mvn/version "0.3.4"}}

 :aliases
 {:dev  {:extra-paths ["dev" "test"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                      org.clojure/test.check {:mvn/version "1.1.3"}
                      nrepl/nrepl {:mvn/version "1.7.0"}
                      io.github.hive-agi/hive-test
                      {:mvn/version "0.3.12"}}}

  :test {:extra-paths ["test"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                      org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.hive-agi/hive-test
                      {:mvn/version "0.3.12"}}
         :main-opts ["-m" "kaocha.runner"]}

  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.8"}}
          :ns-default hive-build.api}}}
