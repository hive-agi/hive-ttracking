{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.1"}
        com.taoensso/timbre {:mvn/version "6.8.0"}

        ;; hive-dsl — Result monad, rescue/guard DSL, bounded-atom, ADTs
        io.github.hive-agi/hive-dsl
        {:git/tag "v0.5.1" :git/sha "335869e023e1bd5bf57c72be881baa647edf4a78"}

        ;; hive-events — event bus for :tt/* events
        io.github.hive-agi/hive-events
        {:git/tag "v0.5.2" :git/sha "24a58a1"}

        ;; hive-weave — named pools, timed execution, parallel primitives
        ;; (Wave 3+ dependency, kept here to pin Wave-1 skeleton deps)
        io.github.hive-agi/hive-weave
        {:git/tag "v0.2.5" :git/sha "5895a2a"}}

 :aliases
 {:dev  {:extra-paths ["dev" "test"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                      org.clojure/test.check {:mvn/version "1.1.1"}
                      nrepl/nrepl {:mvn/version "1.7.0"}
                      io.github.hive-agi/hive-test
                      {:git/tag "v0.2.1" :git/sha "48b480f"}}}

  :test {:extra-paths ["test"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                      org.clojure/test.check {:mvn/version "1.1.1"}
                      io.github.hive-agi/hive-test
                      {:git/tag "v0.2.1" :git/sha "48b480f"}}
         :main-opts ["-m" "kaocha.runner"]}}}
